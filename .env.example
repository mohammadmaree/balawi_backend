PORT=3000
MONGODB_URI=mongodb://localhost:27017/balawi_db

# Required: sent by the app in the "x-api-key" header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change_me_to_a_long_random_string

# Optional: set to 1 when running behind a reverse proxy (nginx, Cloudflare...)
TRUST_PROXY=
# Optional: comma-separated browser origins allowed by CORS (only needed for Flutter web)
CORS_ORIGIN=
