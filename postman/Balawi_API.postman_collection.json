{
  "info": {
    "name": "Balawi Backend API",
    "description": "Balawi Backend API. All /api/* routes require the `x-api-key` header — set the `apiKey` collection variable to the value of API_KEY from .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search Customers by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers?search=محمد",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "محمد"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Customers by First Letter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers?letter=م",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ],
              "query": [
                {
                  "key": "letter",
                  "value": "م"
                }
              ]
            }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"محمد أحمد\",\n  \"phoneNumber\": \"0599123456\",\n  \"pantsHeight\": 105,\n  \"waistWidth\": 90,\n  \"pantsLegWidth\": 20,\n  \"type\": \"عادي\",\n  \"notes\": \"زبون جديد\"\n}"
            }
          }
        },
        {
          "name": "Create Customer (Minimal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"علي حسن\"\n}"
            }
          }
        },
        {
          "name": "Update Customer (Partial)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"waistWidth\": 92,\n  \"notes\": \"تم تحديث المقاس\"\n}"
            }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Work Orders",
      "item": [
        {
          "name": "Get All Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Work Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders?status=جاهز&shelfNumber=1&isPaid=false&dateFrom=2026-01-01&dateTo=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "جاهز"
                },
                {
                  "key": "shelfNumber",
                  "value": "1"
                },
                {
                  "key": "isPaid",
                  "value": "false"
                },
                {
                  "key": "dateFrom",
                  "value": "2026-01-01"
                },
                {
                  "key": "dateTo",
                  "value": "2026-12-31"
                }
              ]
            },
            "description": "status: غير جاهز | جاهز | تم التسليم. shelfNumber: 1,2,3,4,ارض,طاولة. dateTo (YYYY-MM-DD) includes the whole day."
          }
        },
        {
          "name": "Search Work Orders by Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders?search=محمد",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "محمد"
                }
              ]
            }
          }
        },
        {
          "name": "Get Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/statistics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders",
                "statistics"
              ]
            }
          }
        },
        {
          "name": "Get Work Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Create Work Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"محمد أحمد\",\n  \"phoneNumber\": \"0599123456\",\n  \"shelfNumber\": \"1\",\n  \"price\": 50,\n  \"paidAmount\": 20,\n  \"status\": \"غير جاهز\",\n  \"workDescription\": \"تقصير بنطلون\",\n  \"notes\": \"\"\n}"
            },
            "description": "isPaid is computed by the server (price > 0 && paidAmount >= price). paidAmount cannot exceed price."
          }
        },
        {
          "name": "Update Status to Delivered",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"تم التسليم\"\n}"
            },
            "description": "Sets deliveryDate automatically."
          }
        },
        {
          "name": "Mark as Fully Paid",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPaid\": true\n}"
            },
            "description": "Without paidAmount, sets paidAmount = price."
          }
        },
        {
          "name": "Record Partial Payment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paidAmount\": 30\n}"
            }
          }
        },
        {
          "name": "Delete Work Order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/work-orders/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "work-orders",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ]
}